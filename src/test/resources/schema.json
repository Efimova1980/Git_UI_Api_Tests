{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub Search Repositories Response",
  "type": "object",
  "required": ["total_count", "incomplete_results", "items"],
  "properties": {
    "total_count": {
      "type": "integer"
    },
    "incomplete_results": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "full_name", "private"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
